{
  "name": "@markdownee/trafilaturacore",
  "version": "0.8.10",
  "private": false,
  "type": "module",
  "description": "Extract main content by removing boilerplate from supplied HTML.",
  "keywords": [
    "trafilatura",
    "content-extraction",
    "main-content",
    "boilerplate-removal",
    "article-extraction",
    "html-cleaning",
    "html-processing",
    "html",
    "readability",
    "typescript",
    "llm",
    "rag"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markdownee/trafilaturacore.git",
    "directory": "packages/standalone"
  },
  "homepage": "https://github.com/markdownee/trafilaturacore#readme",
  "bugs": "https://github.com/markdownee/trafilaturacore/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trafilaturacore": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && node build-provenance.mjs",
    "prepublishOnly": "node -e \"console.error('trafilaturacore is not published locally: publishing goes through the mirror release-npm.yml OIDC Trusted-Publishing workflow only (never `npm publish`). This guard is an intentional backstop.'); process.exit(1);\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "commander": "^15.0.0",
    "entities": "^8.1.0",
    "html-minifier-terser": "^7.2.0",
    "iconv-lite": "^0.7.3",
    "parse5": "^8.0.1",
    "sanitize-html": "^2.18.0"
  },
  "optionalDependencies": {
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.2"
  },
  "devDependencies": {
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
